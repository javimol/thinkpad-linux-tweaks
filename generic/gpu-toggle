#!/bin/bash
# gpu-toggle: Quickly switch between Intel (Cool) and NVIDIA (Monitor) modes
#
# Usage: gpu-toggle [-y] [intel|on-demand|nvidia|status|auto]
#   No mode given: toggle between intel and on-demand.
#   -y: skip the confirmation prompt.
#   auto: for boot, before the login screen starts (gpu-toggle-auto.service).
#         External monitor connected -> on-demand, otherwise intel.
#
# Switching to intel also unloads the NVIDIA driver and lets the kernel cut
# the GPU's power (D3cold), without waiting for a reboot.

set -euo pipefail

NVIDIA_MODULES="nvidia_uvm nvidia_drm nvidia_modeset nvidia"

usage() {
  echo "Usage: $(basename "$0") [-y] [intel|on-demand|nvidia|status|auto]"
}

# sysfs path of the NVIDIA display controller (PCI class 0x03xxxx)
find_gpu() {
  local d
  for d in /sys/bus/pci/devices/*; do
    if [ "$(cat "$d/vendor")" = "0x10de" ] && [[ "$(cat "$d/class")" == 0x03* ]]; then
      readlink -f "$d"
      return 0
    fi
  done
  return 1
}

# The GPU's own functions (display, HDMI audio, ...) plus the PCIe port above
# it. All of them must be allowed to suspend for the slot to lose power.
gpu_power_devices() {
  local gpu=$1
  ls -d "${gpu%.*}".*
  dirname "$gpu"
}

gpu_power_state() {
  local gpu
  gpu=$(find_gpu) || { echo "not found"; return 0; }
  cat "$gpu/power_state" 2>/dev/null || echo "unknown"
}

unload_nvidia() {
  local i
  systemctl stop nvidia-persistenced 2>/dev/null
  for i in 1 2 3 4 5; do
    # shellcheck disable=SC2086
    modprobe -r $NVIDIA_MODULES 2>/dev/null && return 0
    sleep 1
  done
  return 1
}

# Unload the driver and let the kernel cut the GPU's power. Needs no display
# server holding the GPU.
power_off_gpu() {
  local gpu dev i
  if ! unload_nvidia; then
    echo "Warning: could not unload the NVIDIA driver; reboot to power the GPU off."
    return 0
  fi
  gpu=$(find_gpu) || return 0
  for dev in $(gpu_power_devices "$gpu"); do
    echo auto > "$dev/power/control"
  done
  for i in $(seq 1 15); do
    [ "$(cat "$gpu/power_state")" = "D3cold" ] && break
    sleep 1
  done
  echo "NVIDIA GPU power state: $(cat "$gpu/power_state")"
}

# All external ports are wired to the NVIDIA GPU, so its driver must be
# loaded to see them.
external_monitor_connected() {
  local gpu=$1 status
  for status in "$gpu"/drm/card*/card*-*/status; do
    [ "$(cat "$status" 2>/dev/null)" = "connected" ] && return 0
  done
  return 1
}

# Runs at boot, before the display manager. Must never block the login
# screen, so errors are logged and skipped.
auto_select() {
  local current target gpu i loaded_here=0
  set +e

  current=$(prime-select query)
  if [ "$current" = "nvidia" ]; then
    echo "Mode is 'nvidia' (set by hand); leaving it."
    return 0
  fi
  gpu=$(find_gpu) || { echo "No NVIDIA GPU found."; return 0; }

  if ! lsmod | grep -q '^nvidia_drm'; then
    # -C /dev/null skips prime-select's blacklist in intel mode
    if ! modprobe -C /dev/null nvidia_drm modeset=1; then
      echo "Could not load the NVIDIA driver; keeping '$current'."
      return 0
    fi
    loaded_here=1
  fi

  target=intel
  for i in 1 2 3 4; do
    if external_monitor_connected "$gpu"; then
      target=on-demand
      break
    fi
    sleep 0.5
  done
  echo "External monitor: $([ "$target" = "on-demand" ] && echo yes || echo no) -> '$target'"

  if [ "$target" != "$current" ]; then
    echo "Switching from '$current' to '$target'..."
    prime-select "$target" >/dev/null
  fi

  if [ "$target" = "intel" ]; then
    power_off_gpu
  elif [ "$loaded_here" -eq 1 ]; then
    # Reload with the normal module options (modeset, suspend support)
    unload_nvidia
    modprobe nvidia_drm || echo "Warning: could not load the NVIDIA driver."
  fi
}

# Runs outside the desktop session (via systemd-run), so it survives the
# display manager being stopped. Must never leave the system without a login
# screen, so errors are logged and skipped.
apply_switch() {
  local target=$1 dm=$2
  set +e

  echo "Stopping $dm..."
  systemctl stop "$dm"

  if [ "$target" = "intel" ]; then
    power_off_gpu
  else
    modprobe nvidia_drm || echo "Warning: could not load the NVIDIA driver."
  fi

  echo "Starting $dm..."
  systemctl start "$dm"
}

if [ "${1:-}" = "--apply" ]; then
  apply_switch "$2" "$3"
  exit 0
fi

ASSUME_YES=0
TARGET=""

for arg in "$@"; do
  case "$arg" in
    -y|--yes) ASSUME_YES=1 ;;
    -h|--help) usage; exit 0 ;;
    intel|on-demand|nvidia|status|auto) TARGET="$arg" ;;
    *) usage >&2; exit 1 ;;
  esac
done

if ! command -v prime-select >/dev/null 2>&1; then
  echo "Error: prime-select not found. Install the nvidia-prime package." >&2
  exit 1
fi

CURRENT=$(prime-select query)

if [ "$TARGET" = "auto" ]; then
  if [ "$EUID" -ne 0 ]; then
    echo "Error: 'auto' must run as root, at boot (gpu-toggle-auto.service)." >&2
    exit 1
  fi
  if systemctl is-active --quiet display-manager; then
    echo "Error: 'auto' runs at boot, before the login screen." >&2
    echo "Use 'gpu-toggle intel' or 'gpu-toggle on-demand' instead." >&2
    exit 1
  fi
  auto_select
  exit 0
fi

if [ "$TARGET" = "status" ]; then
  echo "Mode: $CURRENT"
  echo "NVIDIA GPU power state: $(gpu_power_state)  (D3cold = no power)"
  exit 0
fi

if [ -z "$TARGET" ]; then
  if [ "$CURRENT" = "intel" ]; then
    TARGET="on-demand"
  else
    TARGET="intel"
  fi
fi

# In intel mode, also act when the GPU is still powered (e.g. something loaded
# the NVIDIA driver after the switch).
if [ "$TARGET" = "$CURRENT" ]; then
  if [ "$TARGET" != "intel" ] || [ "$(gpu_power_state)" = "D3cold" ]; then
    echo "Already in '$CURRENT' mode. Nothing to do."
    exit 0
  fi
  echo "Already in 'intel' mode, but the NVIDIA GPU is still powered ($(gpu_power_state))."
fi

if [ "$EUID" -ne 0 ]; then
  exec sudo "$0" "$@"
fi

echo "⚠️  WARNING: This will instantly kill your desktop session."
echo "All unsaved work will be lost."

if [ "$ASSUME_YES" -ne 1 ]; then
  read -p "Switch to '$TARGET'? [y/N] " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Aborted."
    exit 1
  fi
fi

case "$TARGET" in
  intel)     echo "Switching to Intel Only (Cooling Mode)..." ;;
  on-demand) echo "Switching to NVIDIA On-Demand (Monitor Mode)..." ;;
  nvidia)    echo "Switching to NVIDIA Performance Mode..." ;;
esac
if [ "$TARGET" != "$CURRENT" ]; then
  prime-select "$TARGET"
fi

# display-manager.service is an alias for gdm, sddm, lightdm, ...
DM=$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" .service)
if [ -z "$DM" ] || [ "$DM" = "display-manager" ]; then
  echo "Could not detect the display manager. Reboot to apply."
  exit 0
fi

echo "Restarting $DM in 2 seconds... (log: journalctl -u gpu-toggle)"
sleep 2
systemd-run --quiet --collect --no-block --unit=gpu-toggle \
  "$(readlink -f "$0")" --apply "$TARGET" "$DM"
